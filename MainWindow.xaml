<Window x:Class="CatchTheSquare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Иванов Иван — Группа ИС-21 — ПР №8: Игровое приложение WPF"
        Height="600" Width="900"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        Focusable="True">

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовочная панель -->
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Иванов Иван — Группа ИС-21"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="ПР №8: Игровое приложение WPF"
                       FontSize="14" Foreground="DarkBlue"/>
            <TextBlock Text="Демонстрация разработки игрового приложения"
                       FontSize="12" FontStyle="Italic" Foreground="Gray"/>
        </StackPanel>

        <!-- Игровое поле -->
        <Border Grid.Row="1" Margin="10" BorderBrush="Gray"
                BorderThickness="1" Background="White">
            <Canvas x:Name="GameCanvas" ClipToBounds="True">
                <Rectangle x:Name="PlayerRect"
                           Width="40" Height="40"
                           Fill="DodgerBlue"
                           Visibility="Collapsed"/>
                <Rectangle x:Name="TargetRect"
                           Width="40" Height="40"
                           Fill="Tomato"
                           Visibility="Collapsed"/>
            </Canvas>
        </Border>

        <!-- Панель управления -->
        <WrapPanel Grid.Row="2" Margin="10" HorizontalAlignment="Center">
            <Button x:Name="BtnStart"   Content="Начать игру"
                    Width="120" Margin="5" Click="BtnStart_Click"/>
            <Button x:Name="BtnPause"   Content="Пауза"
                    Width="120" Margin="5" Click="BtnPause_Click"/>
            <Button x:Name="BtnResume"  Content="Продолжить"
                    Width="120" Margin="5" Click="BtnResume_Click"/>
            <Button x:Name="BtnReset"   Content="Сбросить игру"
                    Width="120" Margin="5" Click="BtnReset_Click"/>
            <Button x:Name="BtnRules"   Content="Показать правила"
                    Width="140" Margin="5" Click="BtnRules_Click"/>
            <Button x:Name="BtnExit"    Content="Выход"
                    Width="120" Margin="5" Click="BtnExit_Click"/>

            <TextBlock x:Name="ScoreText" Text="Счёт: 0" FontSize="16"
                       FontWeight="Bold" Margin="15,10" VerticalAlignment="Center"/>
            <TextBlock x:Name="TimeText" Text="Время: 0" FontSize="16"
                       FontWeight="Bold" Margin="15,10" VerticalAlignment="Center"/>
            <TextBlock Text="Управление: стрелки или WASD"
                       FontSize="12" Foreground="Gray"
                       Margin="15,12" VerticalAlignment="Center"/>
        </WrapPanel>
    </Grid>
</Window>